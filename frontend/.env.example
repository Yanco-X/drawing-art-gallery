# Copy to .env.local (git-ignored) to enable the owner UI.
#
# Must match OWNER_API_TOKEN in backend/.env. The upload button only appears
# when this is set, because uploading without it would fail at the API.
#
# NOTE: Vite inlines VITE_* variables into the built bundle. That is fine for
# a local development stand-in and unacceptable in production -- this whole
# mechanism goes away when real sessions exist.
VITE_OWNER_TOKEN=dev-owner-token
