# Copy to .env and adjust. .env is git-ignored.

# SQLAlchemy URL. Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://sketchyart:sketchyart@localhost:5432/sketchyart

# Shared secret guarding owner-only endpoints until real auth exists.
# Requests must send it as:  X-Owner-Token: <value>
# Endpoints that change data refuse to run while this is unset.
OWNER_API_TOKEN=

FLASK_DEBUG=1
