# Copy to .env and fill in every blank. .env is git-ignored; this file is
# public, so it holds blanks only -- never a working value, not even a local
# one. docker-compose.yml reads .env as well as Flask does.

# Postgres. POSTGRES_PASSWORD belongs to the account docker-compose creates,
# which owns the tables: migrations and `flask set-owner` use it through
# ADMIN_DATABASE_URL. The app connects as gallery_app, created by
# scripts/app_role.sql; STATUS.md section 2 has the steps.
POSTGRES_PASSWORD=
ADMIN_DATABASE_URL=postgresql+psycopg://sketchyart:<POSTGRES_PASSWORD>@127.0.0.1:5432/sketchyart
DATABASE_URL=postgresql+psycopg://gallery_app:<password set in psql>@127.0.0.1:5432/sketchyart

# Object storage: "s3" for MinIO via docker-compose, "local" for backend/uploads.
# The key pair doubles as the MinIO root account (password: 8+ characters).
STORAGE_BACKEND=s3
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 1 has the app create the buckets and set the public-read policy at startup,
# as MinIO needs. 0 in production, where the buckets exist already.
S3_MANAGE_BUCKETS=1

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Development only. With FLASK_DEBUG=0 the app refuses to start unless
# SECRET_KEY and STORAGE_BACKEND are set, COOKIE_SECURE is 1 and
# OWNER_API_TOKEN is empty: the production shape, checked at startup.
FLASK_DEBUG=1
COOKIE_SECURE=0

# Owner credential for the test suites, sent as X-Owner-Token. A back door:
# never set in production -- see context/AUTH.md section 7. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OWNER_API_TOKEN=

# 1 only in production behind Railway's edge, which sets X-Real-IP to the
# caller. Anywhere Flask is reachable directly a client can forge it: leave 0.
TRUST_X_REAL_IP=0
